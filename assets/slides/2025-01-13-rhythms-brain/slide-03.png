<svg width="1920" height="1080" xmlns="http://www.w3.org/2000/svg">
  <rect width="1920" height="1080" fill="#282a36"/>
  <text x="960" y="150" font-family="Arial, sans-serif" font-size="64" fill="#f8f8f2" text-anchor="middle" font-weight="bold">
    What is iEEG?
  </text>
  <text x="300" y="300" font-family="Arial, sans-serif" font-size="32" fill="#50fa7b" text-anchor="start" font-weight="bold">
    Intracranial EEG - Brain signals recorded directly from electrodes
  </text>
  <text x="300" y="400" font-family="Arial, sans-serif" font-size="40" fill="#ff79c6" text-anchor="start" font-weight="bold">
    Advantages
  </text>
  <text x="320" y="470" font-family="Arial, sans-serif" font-size="32" fill="#8be9fd" text-anchor="start">
    • High spatial resolution - Precise localization
  </text>
  <text x="320" y="530" font-family="Arial, sans-serif" font-size="32" fill="#8be9fd" text-anchor="start">
    • High signal-to-noise ratio - Clean signals
  </text>
  <text x="320" y="590" font-family="Arial, sans-serif" font-size="32" fill="#8be9fd" text-anchor="start">
    • Direct cortical access - No skull interference
  </text>
</svg>
