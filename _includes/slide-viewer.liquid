<!-- Slide Viewer Component -->
{% assign slide_id = include.slide_id %}
{% assign slide_title = include.title | default: 'Slides' %}
{% assign slide_data_file = 'assets/slides/' | append: slide_id | append: '/metadata.json' %}

<div class="slide-viewer-container" id="slide-viewer-{{ slide_id }}" data-slide-id="{{ slide_id }}">
  <div class="slide-viewer-header">
    <h3 class="slide-title">{{ slide_title }}</h3>
    <div class="slide-controls">
      <button class="slide-btn" id="fullscreen-btn-{{ slide_id }}" title="Fullscreen" aria-label="Toggle fullscreen">
        <i class="fa-solid fa-expand"></i>
      </button>
      <a
        href="{{ '/assets/slides/' | append: slide_id | append: '.html' | relative_url }}"
        target="_blank"
        class="slide-btn"
        title="Open in new tab"
        aria-label="Open slides in new tab"
      >
        <i class="fa-solid fa-external-link-alt"></i>
      </a>
    </div>
  </div>

  <div class="slide-viewer-main">
    <div class="slide-display">
      <div class="slide-loading"><i class="fa-solid fa-spinner fa-spin"></i> Loading slides...</div>
      <img id="current-slide-{{ slide_id }}" class="current-slide" alt="Current slide">
    </div>

    <div class="slide-navigation">
      <button class="nav-btn prev-btn" id="prev-btn-{{ slide_id }}" aria-label="Previous slide">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <span class="slide-counter" id="slide-counter-{{ slide_id }}">
        <span class="current-slide-num">1</span> / <span class="total-slides-num">-</span>
      </span>
      <button class="nav-btn next-btn" id="next-btn-{{ slide_id }}" aria-label="Next slide">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>

    <div class="slide-progress">
      <div class="progress-bar" id="progress-bar-{{ slide_id }}"></div>
    </div>
  </div>

  <div class="slide-thumbnails" id="thumbnails-{{ slide_id }}">
    <!-- Thumbnails will be dynamically loaded -->
  </div>
</div>

<!-- Load Swiper CSS from CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<!-- Load custom slide viewer CSS -->
<link rel="stylesheet" href="{{ '/assets/css/slide-viewer.css' | relative_url }}">

<!-- Load Swiper JS from CDN -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<!-- Load custom slide viewer JS -->
<script src="{{ '/assets/js/slide-viewer.js' | relative_url }}"></script>

<script>
  // Initialize slide viewer when DOM is ready
  document.addEventListener('DOMContentLoaded', function () {
    initSlideViewer('{{ slide_id }}');
  });
</script>
